# Per-run artefacts: regenerate them, don't version them.
.dossier-cache/
.dossier-log.jsonl
obligations.yaml
obligations-baseline.yaml
coverage.csv
cov-*.csv
# ...except the one CI scores against. The gate is called "scorer reproduces
# the committed reference run", and it cannot do that if the reference is not
# committed: the file existed locally, was ignored by the line above, and the
# gate failed on every run from the day it was added.
!fixtures/floodtwin/cov-embed-12.csv
candidates.csv
inv-*.json
inventory*.json

# ...but the fixture obligations are synthetic and ARE the regression gate.
# score.py cannot score anything without them, so a fresh clone could not run
# the check the README tells a newcomer to run first.
!fixtures/*/obligations.yaml
!fixtures/*/obligations-baseline.yaml
# The inventory behind DESIGN §3.24-§3.30's ablation table. Extraction is the
# slow, model-dependent stage, so the arms are only comparable if they share one
# inventory — and if it is not committed, not a single row of that table can be
# reproduced from a clone. Same reason the two files above are negated.
!fixtures/floodtwin/inv-ablation.json

# Working documents that name client identifiers by location. This repository is
# the one that gets published, so anything naming the engagement lives here and
# never leaves.
.private/

# Compiled bytecode. Committed by an early "git add ." and caught later.
__pycache__/
*.pyc

# macOS writes these into every directory it browses.
.DS_Store
