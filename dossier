#!/usr/bin/env python3
"""dossier — the fresh-clone entry point.

    ./dossier review fixtures/floodtwin --doc deliverable-v2 --against deliverable-v1

Four lines, because the dispatcher is dossier_cli.py and there must be exactly one
of it. This file exists so the thirty-second path in the README works in a clone
with nothing installed; `pip install .` gives the same dispatcher a `dossier`
command through the console-script entry point.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from dossier_cli import main                                    # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
