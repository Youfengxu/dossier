#!/usr/bin/env python3
"""dossier — deliverable review toolkit. One entry point, sensible defaults.

    dossier add      <project> <file> [--role anchor|requirements|draft|reference]
    dossier freeze   <project>              parse and hash-pin; --check for drift
    dossier review   <project> --doc NEW --against OLD
    dossier closure  <project> --from OLD --to NEW
    dossier sweep    <project> --doc DOC [--compare OTHER]
    dossier coverage <project> --doc DOC [--scope architecture]
    dossier report   <project> --from OLD --to NEW
    dossier matrix   <project> --xlsx FILE --sheet NAME --doc SLUG
    dossier writeback <project> --from OLD --to NEW    fill the matrix column
    dossier inventory <project> --doc DOC   [--vllm]
    dossier status   <project>

Working from a comment matrix rather than a requirements document:

    dossier assess    judge each row against the whole current document
    dossier action    test the vendor's claim of what changed against the diff
    dossier combine   put several evaluators side by side, one column each
    dossier render    turn the result into prose for reading away from a screen

Open questions over one document, and the interactive form:

    dossier panel     put the same questions to several models
    dossier judge     grade the answers blind, on a local model
    dossier merge     synthesize the answers, keeping the disagreements
    dossier chat      ask questions interactively, one document held in context

Each forwards its arguments untouched, so `dossier assess --help` is the tool's
own help. Registering them here rather than duplicating their flags is the same
rule the transport follows: one definition, no copies to drift.

`review` is the one to reach for when a revision lands: it runs every
deterministic check in order and tells you what to start next. Nothing in it
needs a model, so it finishes in seconds.

Endpoints default to Ollama on localhost:11434, so a fresh machine needs no
configuration. Override with DOSSIER_CHAT_URL / DOSSIER_EMBED_URL / DOSSIER_MODEL,
or put them in ~/.config/dossier/config. --vllm switches to the concurrent path.
"""

import argparse
import hashlib
import os
import re
import subprocess
import sys

# realpath, not abspath: this is normally invoked through a symlink on PATH, and
# abspath would resolve the scripts relative to the symlink's directory.
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import llm                                                   # noqa: E402

# One resolution path, in llm.py, so a direct `./trace.py` and a
# `dossier coverage` reach the same endpoint. The wrapper used to carry its own
# defaults — a different model name and a different address from the library —
# so the two disagreed, and since the model name is part of the cache key the
# same question asked two ways produced two cache entries.
CHAT = llm.DEFAULT_URL
MODEL = llm.DEFAULT_MODEL
VLLM = os.environ.get("DOSSIER_VLLM_URL", llm.DEFAULT_URL)
VLLM_MODEL = os.environ.get("DOSSIER_VLLM_MODEL", llm.DEFAULT_MODEL)
EMBED = llm.DEFAULT_EMBED_URL
EMBED_MODEL = llm.DEFAULT_EMBED_MODEL


def run(script, *args, quiet=False):
    cmd = [sys.executable, os.path.join(HERE, script)] + [str(a) for a in args]
    if not quiet:
        print(f"\n$ {script} {' '.join(str(a) for a in args[:6])}"
              f"{' …' if len(args) > 6 else ''}\n" + "-" * 72)
    return subprocess.call(cmd)


def model_args(use_vllm, concurrency=None, embed=False):
    args = ["--model", VLLM_MODEL if use_vllm else MODEL,
            "--url", VLLM if use_vllm else CHAT]
    if use_vllm and concurrency:
        args += ["--concurrency", str(concurrency)]
    if embed and EMBED:
        args += ["--embed-url", EMBED]
    if embed and EMBED_MODEL:
        args += ["--embed-model", EMBED_MODEL]
    return args


def embed_args():
    args = []
    if EMBED:
        args += ["--embed-url", EMBED]
    if EMBED_MODEL:
        args += ["--embed-model", EMBED_MODEL]
    return args


def cmd_add(args):
    """Append a document to corpus.yaml with its hash already filled in."""
    project = os.path.abspath(os.path.expanduser(args.project))
    source = os.path.abspath(os.path.expanduser(args.file))
    if not os.path.exists(source):
        sys.exit(f"no such file: {source}")
    rel = os.path.relpath(source, project)
    digest = hashlib.sha256(open(source, "rb").read()).hexdigest()[:12]
    slug = args.slug or os.path.splitext(os.path.basename(source))[0].lower()
    slug = "".join(c if c.isalnum() else "-" for c in slug).strip("-")[:32]

    path = os.path.join(project, "corpus.yaml")
    entry = (f"\n  - path: {rel}\n    slug: {slug}\n    role: {args.role}\n"
             f"    sha256: {digest}\n")
    if os.path.exists(path) and slug in open(path).read():
        sys.exit(f"slug '{slug}' already in corpus.yaml")
    with open(path, "a") as handle:
        handle.write(entry)
    print(f"added {slug}  ({args.role}, {digest})\n{entry}")
    return run("freeze.py", "--project", project)


def cmd_review(args):
    """Everything deterministic, in the order a reviewer wants it."""
    project = os.path.abspath(os.path.expanduser(args.project))
    print("=" * 72)
    print(f"REVIEW  {args.doc}  against  {args.against}")
    print("=" * 72)

    print("\n### 1. corpus integrity — has anything drifted since it was frozen?")
    run("freeze.py", "--project", project, "--check", quiet=True)

    print("\n### 2. what disappeared between revisions")
    run("sweep.py", "xref", "--project", project, "--doc", args.doc,
        "--compare", args.against, "--limit", "8")

    print("\n### 3. which of your findings did they touch")
    if os.path.exists(os.path.join(project, "register-map.yaml")):
        run("closure.py", "--project", project, "--from", args.against,
            "--to", args.doc, "--show-unchanged")
    else:
        print("  (no register-map.yaml — skipped)")

    print("\n### 4. purpose-term sweep")
    if os.path.exists(os.path.join(project, "purpose-terms.txt")):
        run("sweep.py", "vocab", "--project", project, "--doc", args.doc)

    print("\n" + "=" * 72)
    print("Deterministic checks done. Start the RFO coverage run next — it takes")
    print("about fifteen minutes and needs no attention:\n")
    print(f"  dossier coverage {args.project} --doc {args.doc} "
          f"--scope architecture")
    print("\nThen write the review document from both:\n")
    print(f"  dossier report {args.project} --from {args.against} "
          f"--to {args.doc}")
    return 0


def cmd_closure(args):
    extra = ["--show-unchanged"] if args.show_unchanged else []
    return run("closure.py", "--project", args.project, "--from", args.old,
               "--to", args.new, *extra)


def cmd_sweep(args):
    extra = ["--compare", args.compare] if args.compare else []
    run("sweep.py", "xref", "--project", args.project, "--doc", args.doc, *extra)
    if os.path.exists(os.path.join(os.path.expanduser(args.project),
                                   "purpose-terms.txt")):
        run("sweep.py", "vocab", "--project", args.project, "--doc", args.doc)
    return 0


def candidates_for(coverage):
    """cov-deliverable-v2.csv -> candidates-deliverable-v2.csv

    cluster-findings.py defaults to writing candidates.csv, so two coverage runs
    in one project silently overwrite each other's ranked output — including a
    previous run's, which may be the artefact a report cites and the only record
    of which candidates are still unadjudicated. Namespace it to its input.
    """
    stem = os.path.basename(coverage)
    for prefix in ("cov-", "coverage-"):
        if stem.startswith(prefix):
            stem = stem[len(prefix):]
            break
    stem = os.path.splitext(stem)[0]
    return f"candidates-{stem}.csv" if stem else "candidates.csv"


def cmd_coverage(args):
    out = args.out or f"cov-{args.doc}.csv"
    extra = ["--scope", args.scope] if args.scope else []
    code = run("trace.py", "--project", args.project, "--doc", args.doc,
               "--out", out, *extra, *model_args(args.vllm, embed=True))
    if code == 0:
        run("cluster-findings.py", "--project", args.project, "--coverage", out,
            "--out", candidates_for(out), *embed_args())
    return code


def cmd_report(args):
    """The work product: closure and coverage merged into one document."""
    project = os.path.abspath(os.path.expanduser(args.project))
    coverage = args.coverage or f"cov-{args.new}.csv"
    extra = []
    if os.path.exists(os.path.join(project, coverage)):
        extra += ["--coverage", coverage]
        candidates = args.candidates or candidates_for(coverage)
        if os.path.exists(os.path.join(project, candidates)):
            extra += ["--candidates", candidates]
    else:
        print(f"note: no {coverage} — findings closure only, no RFO coverage "
              f"section.\n      Run `dossier coverage` first for the full "
              f"report.\n")
    # The comment matrix, if the project keeps one where freeze.py puts
    # sources. Its presence changes what the report leads with: not "what did
    # they change" but "what did they claim, and does the document support it".
    matrix = args.matrix or "source/feedback-matrix.xlsx"
    if os.path.exists(os.path.join(project, matrix)):
        extra += ["--matrix", matrix]
        if args.sheet:
            extra += ["--sheet", args.sheet]

    return run("register.py", "--project", project, "--from", args.old,
               "--to", args.new, *extra,
               *(["--out", args.out] if args.out else []))


def cmd_cluster(args):
    return run("cluster-findings.py", "--project", args.project,
               "--coverage", args.coverage,
               "--out", args.out or candidates_for(args.coverage), *embed_args())


def cmd_inventory(args):
    out = args.out or f"inventory-{args.doc}.json"
    code = run("inventory.py", "--project", args.project, "--doc", args.doc,
               "--out", out, *model_args(args.vllm, concurrency=48))
    if code == 0:
        run("synthesize.py", "--project", args.project, "--inventory", out)
    return code


def cmd_status(args):
    project = os.path.abspath(os.path.expanduser(args.project))
    print(f"project: {project}\n")
    for name in ("corpus.yaml", "register-map.yaml", "lexicon.yaml",
                 "purpose-terms.txt", "obligations.yaml", "components.yaml"):
        mark = "yes" if os.path.exists(os.path.join(project, name)) else " no"
        print(f"  [{mark}] {name}")

    # Which scopes exist, and how many obligations each holds. One requirements
    # document governs several deliverables, so a coverage run without --scope
    # judges the deliverable against obligations it never owed and reports them
    # all unmet. You cannot pass the right scope without first knowing the
    # options, and nothing else prints them.
    obligations = os.path.join(project, "obligations.yaml")
    if os.path.exists(obligations):
        counts = {}
        for line in open(obligations, encoding="utf-8", errors="replace"):
            match = re.match(r'\s*scope:\s*"?([^"\n]+?)"?\s*$', line)
            if match:
                counts[match.group(1)] = counts.get(match.group(1), 0) + 1
        if counts:
            total = sum(counts.values())
            print(f"\nobligation scopes ({total} total) — pass one as --scope:")
            for scope, count in sorted(counts.items(), key=lambda x: -x[1]):
                print(f"  {count:>4}  {scope}")
            print("\n  A coverage run without --scope judges the deliverable "
                  "against every\n  obligation, including those another "
                  "deliverable owes, and reports\n  each of those unmet.")
    print()
    return run("freeze.py", "--project", project, "--check", quiet=True)


# Ten tools were reachable only by knowing their filenames, so `dossier --help`
# showed none of the newest work. They forward argv rather than re-declaring it:
# a second copy of a flag is a second thing to drift, which is the failure this
# repository has now fixed twice elsewhere.
PASSTHROUGH = {
    "assess":  ("assess.py", "judge each matrix row against the whole document"),
    "action":  ("action-check.py", "test a claimed change against the diff, no model"),
    "combine": ("combine-evaluators.py", "one column per evaluator, side by side"),
    "column":  ("assess-to-matrix.py", "write assess results into the matrix"),
    "insert":  ("insert-column.py", "insert a column, shifting the rest right"),
    "render":  ("render-assess.py", "assess results as prose for an e-reader"),
    "panel":   ("panel.py", "put open questions to a model over one document"),
    "judge":   ("judge-panel.py", "grade panel answers blind, on a local model"),
    "merge":   ("synthesize-panel.py", "synthesize answers, keeping disagreements"),
    "chat":    ("converse.py", "interactive questions, one document held in context"),
    "repair":  ("repair-cites.py", "recover locators a strict grammar discarded"),
}


def main():
    # Dispatch passthrough commands BEFORE argparse sees them. REMAINDER does not
    # capture a leading optional, so `dossier assess --help` had --help eaten by
    # this parser and died with "unrecognized arguments" instead of showing the
    # tool's help. They are still registered below so they appear in `--help`.
    if len(sys.argv) > 1 and sys.argv[1] in PASSTHROUGH:
        return run(PASSTHROUGH[sys.argv[1]][0], *sys.argv[2:], quiet=True)

    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("add"); p.add_argument("project"); p.add_argument("file")
    p.add_argument("--role", default="draft"); p.add_argument("--slug")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("freeze"); p.add_argument("project")
    p.add_argument("--check", action="store_true")
    # --init exists in freeze.py and was never registered here, so the first
    # command of the first documented workflow failed with an argparse error.
    p.add_argument("--init", action="store_true",
                   help="write a starter corpus.yaml for a new project")
    p.add_argument("--refreeze", action="store_true",
                   help="re-extract after a source changed (INVALIDATES locators)")
    p.set_defaults(fn=lambda a: run("freeze.py", "--project", a.project,
                                    *(["--check"] if a.check else []),
                                    *(["--init"] if a.init else []),
                                    *(["--refreeze"] if a.refreeze else [])))

    p = sub.add_parser("review"); p.add_argument("project")
    p.add_argument("--doc", required=True); p.add_argument("--against", required=True)
    p.set_defaults(fn=cmd_review)

    p = sub.add_parser("closure"); p.add_argument("project")
    p.add_argument("--from", dest="old", required=True)
    p.add_argument("--to", dest="new", required=True)
    p.add_argument("--show-unchanged", action="store_true")
    p.set_defaults(fn=cmd_closure)

    p = sub.add_parser("sweep"); p.add_argument("project")
    p.add_argument("--doc", required=True); p.add_argument("--compare")
    p.set_defaults(fn=cmd_sweep)

    p = sub.add_parser("coverage"); p.add_argument("project")
    p.add_argument("--doc", required=True); p.add_argument("--scope")
    p.add_argument("--out"); p.add_argument("--vllm", action="store_true")
    p.set_defaults(fn=cmd_coverage)

    p = sub.add_parser("cluster"); p.add_argument("project")
    p.add_argument("--coverage", required=True); p.add_argument("--out")
    p.set_defaults(fn=cmd_cluster)

    p = sub.add_parser("report"); p.add_argument("project")
    p.add_argument("--from", dest="old", required=True)
    p.add_argument("--to", dest="new", required=True)
    p.add_argument("--coverage"); p.add_argument("--candidates")
    p.add_argument("--matrix"); p.add_argument("--sheet")
    p.add_argument("--out")
    p.set_defaults(fn=cmd_report)

    p = sub.add_parser("inventory"); p.add_argument("project")
    p.add_argument("--doc", required=True); p.add_argument("--out")
    p.add_argument("--vllm", action="store_true")
    p.set_defaults(fn=cmd_inventory)

    p = sub.add_parser("matrix"); p.add_argument("project")
    p.add_argument("--xlsx", required=True); p.add_argument("--sheet", required=True)
    p.add_argument("--doc", required=True); p.add_argument("--out")
    p.set_defaults(fn=lambda a: run(
        "matrix.py", "--project", a.project, "--xlsx", a.xlsx,
        "--sheet", a.sheet, "--doc", a.doc,
        *(["--out", a.out] if a.out else []), *model_args(False)))

    p = sub.add_parser("writeback"); p.add_argument("project")
    p.add_argument("--from", dest="old", required=True)
    p.add_argument("--to", dest="new", required=True)
    p.add_argument("--xlsx", default="source/feedback-matrix.xlsx")
    p.add_argument("--sheet", default="Comments")
    p.add_argument("--col", default="I"); p.add_argument("--out")
    p.add_argument("--overwrite", action="store_true")
    p.set_defaults(fn=lambda a: run(
        "writeback.py", "--project", a.project, "--from", a.old, "--to", a.new,
        "--xlsx", a.xlsx, "--sheet", a.sheet, "--col", a.col,
        *(["--out", a.out] if a.out else []),
        *(["--overwrite"] if a.overwrite else [])))

    p = sub.add_parser("doctor")
    p.add_argument("--project", nargs="?")
    p.set_defaults(fn=lambda a: run("doctor.py",
                                    *(["--project", a.project] if a.project else [])))

    p = sub.add_parser("status"); p.add_argument("project")
    p.set_defaults(fn=cmd_status)

    for name, (script, blurb) in PASSTHROUGH.items():
        # add_help=False so --help reaches the tool rather than being eaten here.
        p = sub.add_parser(name, help=blurb, add_help=False)
        p.add_argument("rest", nargs=argparse.REMAINDER)
        p.set_defaults(fn=lambda a, s=script: run(s, *a.rest))

    args = parser.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
